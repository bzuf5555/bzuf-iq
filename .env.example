# Telegram Bot Token (BotFather dan olinadi)
BOT_TOKEN=your_bot_token_here

# MongoDB Atlas URI (mongodb+srv://... formatida)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/bzuf_iq?retryWrites=true&w=majority

# Render.com app URL (https://your-app.onrender.com formatida)
WEBHOOK_URL=https://your-app.onrender.com

# Port (Render avtomatik o'rnatadi, odatda 10000)
PORT=8443

# Debug rejimi (production da False bo'lsin)
DEBUG=False
